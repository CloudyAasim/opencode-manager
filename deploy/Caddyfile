# OpenCode Manager — production Caddyfile
#
# Requires the environment variables OCM_DOMAIN (and optionally OCM_ACME_EMAIL).
# Only ports 80/443 are published; the app container is reachable only on the
# internal docker network as `app:5003`.
#
# Optional hardening extras that need a custom Caddy build (xcaddy):
#   - github.com/mholt/caddy-ratelimit  → connection-level rate limiting
#   - github.com/caddyserver/transform-encoder, etc.
# The application already enforces per-IP auth rate limits; add the plugin only
# if you want a second layer in front of Caddy.

{
	# Listen on unprivileged ports inside the container; Docker maps 80/443 to
	# these on the host. This keeps the Caddy process non-root.
	http_port 8080
	https_port 8443
}

{$OCM_DOMAIN} {
	encode zstd gzip

	# Security headers (the app also sets these; Caddy guarantees them even if a
	# response bypasses the app, e.g. an error page generated by Caddy).
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Reject oversized bodies before they reach the app.
	request_body {
		max_size 64MB
	}

	# Optional: restrict access to known networks / VPN only.
	# Uncomment and replace with your own CIDRs.
	# @blocked not remote_ip 203.0.113.0/24 10.8.0.0/24
	# respond @blocked 403

	reverse_proxy app:5003 {
		# Overwrite, never append, the client-supplied forwarding headers so the
		# app can trust them for per-IP rate limiting.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}

		# If another proxy/CDN sits in front of Caddy, add its ranges here so
		# {remote_host} resolves to the real client, e.g.:
		# trusted_proxies static 173.245.48.0/20 103.21.244.0/22

		# Keep SSE / streaming responses unbuffered.
		flush_interval -1
	}

	log {
		output stderr
		format console
	}
}
