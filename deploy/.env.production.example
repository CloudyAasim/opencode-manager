# OpenCode Manager — production environment (VPS + Caddy)
# Copy to `.env` in this deploy/ directory, then run deploy/gen-secrets.sh.

# ---- Public endpoint -------------------------------------------------------
# Your DNS A/AAAA record must already point at this VPS.
OCM_DOMAIN=opencode.example.com
# Optional ACME account email (recommended for Let's Encrypt expiry notices).
OCM_ACME_EMAIL=you@example.com

# ---- Session encryption ----------------------------------------------------
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME

# ---- First administrator (bootstrap) ---------------------------------------
# Created on first startup. Accounts cannot self-register; this is how the
# first admin comes into existence. Change the password afterwards and remove
# ADMIN_PASSWORD from this file (or keep it for disaster recovery).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Set to true only for a one-off password reset, then remove.
# ADMIN_PASSWORD_RESET=false

# ---- Origins ---------------------------------------------------------------
# Must include the public HTTPS origin. No trailing slash.
AUTH_TRUSTED_ORIGINS=https://opencode.example.com

# Set to false only if you deliberately expose the app without TLS.
AUTH_SECURE_COOKIES=true

# Trust X-Forwarded-For from the Caddy container (required for per-IP limits).
AUTH_TRUST_PROXY=true

# ---- Self-registration -----------------------------------------------------
# Keep false for public deployments: only administrators create accounts.
AUTH_ALLOW_SIGNUP=false
# Optional allowlists for controlled invitations (only used when signup is off).
# AUTH_ALLOWED_EMAILS=friend@example.com
# AUTH_ALLOWED_EMAIL_DOMAINS=example.com

# ---- Security headers ------------------------------------------------------
SECURITY_HSTS=true
# Override only if the default Content-Security-Policy breaks a feature.
# SECURITY_CSP=

# ---- Passkeys (WebAuthn) ---------------------------------------------------
PASSKEY_RP_ID=opencode.example.com
PASSKEY_RP_NAME=OpenCode Manager
PASSKEY_ORIGIN=https://opencode.example.com

# ---- OAuth providers (optional) -------------------------------------------
# New OAuth identities are blocked unless AUTH_ALLOW_SIGNUP=true or the email
# is allowlisted, so enabling a provider is safe for existing accounts only.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Push notifications (optional) ----------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---- Workspace -------------------------------------------------------------
# Bind mount a DEDICATED host directory. Never mount $HOME or /.
OCM_WORKSPACE_HOST_PATH=/srv/opencode/workspace
# Match the owner of the workspace directory so files stay usable on the host.
PUID=1000
PGID=1000

# ---- Misc ------------------------------------------------------------------
LOG_LEVEL=info
# Bump to force a fresh opencode/uv tool reinstall on the next build.
TOOLS_CACHEBUST=0
# Debian apt mirror used while building the image (host is never modified).
# Defaults to mirrors.ustc.edu.cn; set to deb.debian.org for the upstream default.
# DEBIAN_MIRROR=mirrors.ustc.edu.cn
# npm registry used while building (pnpm/corepack/npx).
# Defaults to registry.npmmirror.com; set to https://registry.npmjs.org for upstream.
# NPM_REGISTRY=https://registry.npmmirror.com
# Install Chromium/Playwright system libraries for browser automation
# (adds ~1 GB). Leave false unless the agent needs a browser.
# WITH_PLAYWRIGHT=false
# Base URL for OpenCode release downloads. Point at a mirror/proxy when GitHub
# release assets are unreachable from the build host.
# OPENCODE_DOWNLOAD_BASE=https://github.com/anomalyco/opencode/releases
# Lock server environment-variable editing to admins (recommended).
OCM_ALLOW_SERVER_ENV_EDIT=false

# ---- Web terminal ------------------------------------------------------------
# The image ships python3, used by the PTY bridge. Disable if unused.
#
# A non-admin shell runs inside a chroot that holds only that person's own
# workspace. That requires the container to allow unprivileged user namespaces,
# which Docker's default seccomp profile blocks - see docs/features/terminal.md
# for the one-off server-side change. Without it the terminal is refused for
# non-admins rather than served unconfined.
OCM_TERMINAL_ENABLED=true
# false = everyone, with the sandbox as the boundary. true = administrators only.
OCM_TERMINAL_ADMINS_ONLY=false
# Turning this off leaves non-admins without a terminal: there is then no
# per-user directory to confine them to, and the server refuses rather than
# binding the shared workspace.
# OCM_TERMINAL_PER_USER_HOME=true
# Must stay inside the workspace; anything else falls back to the workspace.
# OCM_TERMINAL_CWD=/workspace
# OCM_TERMINAL_IDLE_TIMEOUT_MS=900000
# OCM_TERMINAL_MAX_DURATION_MS=28800000
