<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted for loopback and nothing else.

  The WebView is only ever pointed at `http://127.0.0.1:<port>`, where the
  in-process proxy listens. Everything the user actually reaches travels over TLS
  to the server they named, in the proxy's own socket stack - and that stack
  verifies certificates properly, so this file does not weaken it. What this file
  does decide is that a page cannot quietly downgrade a real request to
  plaintext, which is the part a blanket `usesCleartextTraffic="true"` would
  have given away.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>