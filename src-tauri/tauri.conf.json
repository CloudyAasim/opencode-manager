{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCode Manager",
  "version": "0.18.0",
  "identifier": "cd.aasim.opencode.manager",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "OpenCode Manager",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "category": "DeveloperTool",
    "shortDescription": "OpenCode Manager client",
    "longDescription": "Cross-platform client for OpenCode Manager"
  }
}
